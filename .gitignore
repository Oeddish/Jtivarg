# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

#
# Jetbrains IntelliJ stuff
#

# stuff generated by (auto) import of POM
*.iws
*.iml

# exclude workspace-specific files
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/**/workspace.xml
.idea/**/tasks.xml

# Include these in git
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
!.idea/compiler.xml
!.idea/misc.xml
!.idea/vcs.xml
!.idea/modules.xml

# engine config file(s) will be created if not existing
astrovania.config

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/target/
